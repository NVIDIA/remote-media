[Unit]
Description=Virtual Media Service
# Boot-time fix (2026-09-23, item #43), edited directly via `devtool
# modify remote-media`: virtual-media does real, serialized sysfs writes
# (per-NBD-device, ~50-100ms apart, 4 devices x multiple USB slots) very
# early in its own startup -- found via journal-density analysis of the
# bmc-boot-complete.service-to-x86-power-control contention window (63 of
# ~288 log lines in that window came from this one service). No reverse
# dependency exists (confirmed via `systemctl list-dependencies
# --reverse`) and remote/virtual media has no bearing on DC-ON readiness.
# Deferring past bmc-boot-complete.service removes it from that window
# entirely. Live-tested: contributed to the fastest of 3 test cycles
# (76.95s DC-ON) combined with item #40's bmc-boot-complete.service fix;
# net measured DC-ON (T2) improvement together: 81.82s -> 77.81s P50.
After=dbus.service bmc-boot-complete.service
Requires=dbus.service

[Service]
RuntimeDirectory=virtual-media
ExecStart=/usr/sbin/virtual-media
Restart=always
Type=dbus
BusName=xyz.openbmc_project.VirtualMedia

[Install]
WantedBy=multi-user.target
